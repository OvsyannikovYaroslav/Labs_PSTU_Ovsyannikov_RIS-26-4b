//Задача на нахождение числа

#include <iostream>
#include <cmath>
using namespace std;

int main() 
{
   
    int n = 1925;
    int z = 2;
    bool f = false;
    while ((n > 0) && !f)
    {
        int digit = n % 10;
        if (digit == z)
        {
            f = true;
        } else
        {
            n = n / 10;
        }
    }

    if (f)
    {
        cout <<"number " << z << " in number " << endl;
    } else
    {
        cout <<"number" << z << "not in number" << endl;
    }
    return 0;
}
